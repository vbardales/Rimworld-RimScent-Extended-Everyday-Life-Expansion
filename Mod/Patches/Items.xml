<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Objets vanilla domestiques que RimScent laissait muets. -->
  <!-- Biere et mout : c est de la fermentation, comme le fut et la brasserie. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Beer" or defName="Wort") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Beer" or defName="Wort") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Fermenting</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Beer" or defName="Wort") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Beer" or defName="Wort") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Fermenting</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Foin, houblon et herbes medicinales : du vegetal coupe et seche. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Hay" or defName="RawHops" or defName="MedicineHerbal") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Hay" or defName="RawHops" or defName="MedicineHerbal") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_DriedHerbs</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Hay" or defName="RawHops" or defName="MedicineHerbal") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Hay" or defName="RawHops" or defName="MedicineHerbal") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_DriedHerbs</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>


</Patch>
